# Base URL of the SNACC backend API (INT-101..104).
# Leave empty to run the UI against its built-in demo data only.
# Example (live backend): VITE_API_BASE=https://8787-agq3sgcdseushmj4q73lv3xqea.instabox.tech
VITE_API_BASE=

# Optional DEX & swap terminal configuration (RES-107 & RES-108)
VITE_SNACC_TOKEN_ID=
VITE_REF_INDEXER_URL=https://api.rhea.finance
VITE_INTENTS_API_URL=https://1click.chaindefuser.com

# Optional email / social login through Privy inside the NEAR Connect wallet picker (UI-145).
# Public ids from the Privy dashboard, not secrets. Leave VITE_PRIVY_APP_ID empty to turn it off;
# VITE_PRIVY_CLIENT_ID is optional and only passed to Privy when set.
VITE_PRIVY_APP_ID=
VITE_PRIVY_CLIENT_ID=

# Optional player profiles, notifications and achievements (UI-148, UI-149) on Supabase.
# The project URL and its publishable key are public by design (row-level security guards the data).
# Leave either empty to hide every profile feature; the game works the same without them.
# Example: VITE_SUPABASE_URL=https://vldhsabgpfxccsljdtye.supabase.co
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=

# Optional Cloudflare Turnstile for the starter-pack claim (SEC-119). The public SITE key from the
# Cloudflare dashboard, not the secret (the secret, SNACC_TURNSTILE_SECRET, lives on the backend only).
# Leave empty to load no Turnstile script and draw no widget; the claim then sends no token. Set it
# together with the backend secret; with the key set but no backend secret the token is just ignored.
VITE_TURNSTILE_SITE_KEY=

